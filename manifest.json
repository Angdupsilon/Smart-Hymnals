{
  "manifest_version": 3,
  "name": "Smart Hymnals",
  "version": "1.4.0",
  "description": "Smart tools for hymn pages: multilingual lyrics side by side, syllable-accurate repeat chords, and Chinese-English alignment.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://formspree.io/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hymnal.net/*/hymn/*",
        "https://hymnal.net/*/hymn/*"
      ],
      "js": ["src/chords.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://songbase.life/*",
        "https://www.songbase.life/*"
      ],
      "js": ["src/chords.js", "src/songbase.js"],
      "css": ["src/songbase.css"],
      "run_at": "document_idle"
    }
  ]
}
