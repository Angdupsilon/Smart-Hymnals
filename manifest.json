{
  "manifest_version": 3,
  "name": "Smart Hymnals",
  "version": "1.2.1",
  "description": "Smart tools for Hymnal.net hymn pages: multilingual lyrics side by side, chords through every stanza, and Chinese-English alignment.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://formspree.io/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hymnal.net/*/hymn/*",
        "https://hymnal.net/*/hymn/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
