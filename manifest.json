{
  "manifest_version": 3,
  "name": "Hymnal.net Multilingual Lyrics",
  "version": "1.0.0",
  "description": "Adds a Multilingual button to Hymnal.net hymn pages to show the original lyrics side by side with any available translation.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.hymnal.net/*/hymn/*",
        "https://hymnal.net/*/hymn/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
